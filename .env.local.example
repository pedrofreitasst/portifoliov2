# =============================================================================
# Renomeie este arquivo para .env.local e preencha os valores.
# NÃO commite o .env.local — ele já está no .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Anthropic Claude — usado como fallback quando o Watson não tem resposta
# Console: https://console.anthropic.com/settings/keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------------------
# IBM Watson Assistant — para todas as 3 variáveis, vá em:
#   IBM Cloud → Watson Assistant → seu assistant → ⚙️ Settings → API details
# -----------------------------------------------------------------------------

# Chave de API da instância do Watson Assistant
WATSON_API_KEY=

# URL da instância — copie EXATAMENTE como aparece em "Service instance URL"
# (inclui o trecho /instances/<uuid>)
WATSON_SERVICE_URL=https://api.us-south.assistant.watson.cloud.ibm.com/instances/<id>

# Identificador do ambiente do assistant.
#   - Modelo Actions (padrão hoje): cole o "Live Environment ID" (se publicado)
#     ou o "Draft Environment ID" (versão em desenvolvimento).
#   - Modelo Dialog clássico: cole o "Assistant ID".
# NÃO use o "Assistant ID" para Actions — o endpoint v2 retorna 404.
WATSON_ASSISTANT_ID=


#MONGODB
MONGODB_URI=mongodb://pedrofreitasstdb:huaauh1716911@ac-kiwz8yh-shard-00-00.29gafra.mongodb.net:27017,ac-kiwz8yh-shard-00-01.29gafra.mongodb.net:27017,ac-kiwz8yh-shard-00-02.29gafra.mongodb.net:27017/?ssl=true&replicaSet=atlas-kwobia-shard-0&authSource=admin&appName=Portfolio-Chatlogs

#Analytics Dashboard
ADMIN_PASSWORD=
NEXT_PUBLIC_ADMIN_PASSWORD=